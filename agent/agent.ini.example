[webapp]
; the midhong bridge middleware (server/mid.js). Production: https://midhong.berkatselalu.com
url = http://127.0.0.1:3100
; must match AGENT_TOKEN in the VPS .env (read by midhong)
token = change-me-agent-token

[mysql]
; the LOCAL ESB POS database (never expose it beyond the LAN)
host = 127.0.0.1
port = 3306
user = esb
password = secret
db = sushipos

[agent]
; a REAL cashier username from ms_posuser — all bridge writes are stamped with it
cashier_username = PTGNBKASIR1
; brand code portion of salesNum (e.g. SUSHO). Leave empty to derive from an existing sale.
brand_code =
poll_seconds = 5
; push the ESB menu to the webapp at startup and every N minutes (0 = manual --sync-menu only)
menu_sync_minutes = 10
default_pax = 2
state_file = agent_state.json

; ---- optional: Hong Chiang table name -> ESB tableName (when they differ) ----
;[tables]
;A05 = 5

; ---- optional: KDS POLLER ----
; Set base_url to mirror orders placed on Hong Chiang's OWN ordering app into
; ESB (the agent polls tables/search + orders/details, writes the same TXN A/B,
; and when the cashier settles on ESB it closes the KDS order via
; reservations/update / walkIns/update). Leave the section out (or base_url
; empty) to disable the poller — the webapp bridge keeps working either way.
;[kds]
;base_url = http://192.168.100.200:5500/kds
;poll_seconds = 5

; ---- optional: KDS meal_id -> ESB menuCode ----
; The KDS meal_id is vendor-assigned and read-only; map each one to the ESB
; menuCode you set in ESB Core. Unmapped meals fall back to an exact
; menuName match. Prices ALWAYS come from ESB (menu template), never the KDS.
;[kds_menu_map]
;380 = KDS-380
;379 = KDS-379
