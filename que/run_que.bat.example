@echo off
rem quehong local server — Windows mini-PC launcher.
rem COPY this file to e.g. C:\hcbridge\run_que.bat and fill in the values;
rem never commit the filled copy (QUE_TOKEN is a secret).
cd /d C:\hcbridge\repo

rem bind the LAN so the tablet/TVs can reach this PC
set HOST=0.0.0.0
set QUE_PORT=3200

rem staff PIN for /admin
set QUE_PIN=4321

rem public mirror (landing pages): QUE_TOKEN must equal the VPS .env value
set QUE_PUB_URL=https://quehong.berkatselalu.com
set QUE_TOKEN=change-me

rem the WhatsApp bot number (goes into the printed wa.me QR), digits only
set QUE_WA_NUMBER=628xxxxxxxxxx

rem voice on the displays: id | id+en
set QUE_VOICE=id+en

rem printer: share:\\localhost\TMT82X (shared Epson driver, USB) or
rem net:<printer-ip>:9100 (Ethernet). Unset = jobs append to a dev file.
rem set QUE_PRINT=share:\\localhost\TMT82X

node que\server.js
pause
