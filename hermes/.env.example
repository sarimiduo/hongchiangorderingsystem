# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=paste-your-bot-token

# Only these Discord user IDs may talk to Hermes (comma-separated).
# Right-click your profile in Discord (Developer Mode on) -> Copy User ID.
ALLOWED_USER_IDS=123456789012345678

# Optional: restrict to one channel ID (empty = any channel the bot can read)
ALLOWED_CHANNEL_ID=

# Folder the agent works in (your project clone on the VPS)
PROJECT_DIR=/var/www/hongchiangorderingsystem

# Command used to run the agent. {prompt} is replaced with your message.
# Default uses Claude Code CLI in non-interactive mode, continuing the
# previous conversation in PROJECT_DIR.
AGENT_CMD=claude --continue -p {prompt}

# Seconds before a run is aborted
AGENT_TIMEOUT=600
