# Port the web app listens on
PORT=3000

# KDS_MODE=mock  -> built-in simulator of the Hong-Chiang KDS API (default, no hardware needed)
# KDS_MODE=real  -> forward KDS calls to a real KDS device/server
KDS_MODE=mock

# Base path of the real KDS API (only used when KDS_MODE=real)
# Per spec: Base Path = http://{host}:5500/kds/
KDS_BASE_URL=http://192.168.1.50:5500/kds

# Currency prefix used by the frontend price formatter
CURRENCY=Rp

# ---- ESB POS bridge ----
# Shared secret the local SQL agent uses on /api/bridge/agent/* calls
AGENT_TOKEN=change-me-agent-token
# 1 = built-in simulator advances bridge stages when no live agent is connected
BRIDGE_SIM=1
BRIDGE_SIM_SETTLE_SECONDS=25
